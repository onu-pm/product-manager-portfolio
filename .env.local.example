# Get a free access key at https://web3forms.com (just enter your email,
# no account needed, the key arrives by email). Copy this file to
# .env.local and paste the key in, then restart `npm run dev`.
NEXT_PUBLIC_WEB3FORMS_KEY=your-access-key-here

# Not currently used by any code — the Cal.com scheduling embed on /about
# needs no key, since it's just the public booking widget loaded client-
# side. Kept here in case a server-side Cal.com API call gets added later.
# Never rename this with a NEXT_PUBLIC_ prefix; that would ship it to the
# browser bundle.
CAL_API_KEY=your-cal-api-key-here
